<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/primary"
            app:theme="@style/Theme.MisLugares.AppBarOverlay">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/nearby_places"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <HorizontalScrollView
        android:id="@+id/scrollDistancia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgDistancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip1km"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/dist_1km" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip3km"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dist_3km" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip5km"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dist_5km" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodosDistancia"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dist_todos" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Filtros de categoría para Lugares Cercanos -->
    <HorizontalScrollView
        android:id="@+id/scrollCategoriasCercanos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/scrollDistancia">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgCategoriasCercanos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCercanoTodos"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCercanoComida"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_food_drinks" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCercanoNaturaleza"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_nature" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCercanoHoteles"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_hotel" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCercanoGasolineras"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_gas_station" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCercanoServicios"
                style="@style/Widget.MisLugares.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_services" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Barra de búsqueda en tiempo real -->
    <EditText
        android:id="@+id/etSearchCercanos"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/search_background"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:drawableTint="@color/search_hint"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/search_hint"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/scrollCategoriasCercanos" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLugaresCercanos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etSearchCercanos"
        tools:listitem="@layout/item_lugar_cercano" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_nearby_found"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
